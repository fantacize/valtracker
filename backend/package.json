{
  "name": "valorant-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for VALORANT skin tracker",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/*.test.js",
    "build:exe": "npx pkg . --targets node18-win-x64 --output ../release/staging/ValorantTrackerBackend.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "src/services/*.csv"
    ]
  },
  "keywords": ["valorant", "tracker", "api", "skins"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  }
}
